{
  "name": "duskbloods-blood-covenant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/package-offline.mjs && node scripts/verify-package.mjs",
    "preview": "vite preview --outDir offline",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "format": "oxfmt",
    "test": "vitest run",
    "simulate": "node --experimental-strip-types --no-warnings scripts/simulate.ts",
    "release": "npm run build && python3 scripts/package-release.py"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "5.0.5"
  }
}
